# Sigil reads these at startup, in the composition root only.
# Provider accounts (keys, models, reasoning level) are configured from the UI
# with /provider, /model and /effort: no credential belongs in this file.

# Hard step limit per turn: every model response and every call to a tool count
# as one step. Exceeding it aborts the turn.
SIGIL_MAX_STEPS=256

# Total attempts per model request when the provider fails transiently
# (5xx, 429 rate limit, dropped connection or timeout). The first attempt is
# included. Permanent errors (quota exhausted, request rejected) are not retried.
SIGIL_MODEL_MAX_ATTEMPTS=5

# Where Sigil keeps sessions, roadmaps and provider credentials.
# Defaults to ~/.sigil. Uncomment to isolate an installation or a test sandbox.
# SIGIL_HOME=/path/to/sigil-state

# --- context management ------------------------------------------------------

# View strategy: `windowed` trims reasoning, old tool results and old turns;
# `compacting` also collapses old turns into a summary; `passthrough` sends the
# history as it is.
SIGIL_CONTEXT_STRATEGY=windowed

# Turns kept intact before trimming starts.
SIGIL_CONTEXT_KEEP_RECENT_TURNS=3

# Cap of an old tool result, in characters.
SIGIL_CONTEXT_MAX_TOOL_RESULT_CHARS=4000

# Tokens reserved for the model response.
SIGIL_CONTEXT_OUTPUT_RESERVE=8000

# How much reasoning travels back to the model.
#
#   empty / a number  steps of the round in progress to keep (default 4)
#   all               keep every reasoning block of the whole session
#   off               drop all reasoning
#   1, true, yes, on  legacy "keep everything"
#
# A round is everything until control goes back to the user, steering included.
# Only the round in progress keeps its reasoning: past rounds are a record, and they
# are resent on every request. Keeping the whole round is quadratic, so the window is
# on steps. Signed reasoning is only replayed to the provider that produced it.
SIGIL_CONTEXT_KEEP_THINKING=4

# --- workspaces --------------------------------------------------------------

# Where `/new --worktree` creates the worktrees. It must stay OUTSIDE the
# repository: if it sat inside a work tree, the file tools of one workspace could
# reach the tree of another. One folder per repository and one per worktree name:
# <dir>/<repo>/<name>. Defaults to <SIGIL_HOME>/worktrees.
# SIGIL_WORKTREES_DIR=~/.sigil/worktrees

# --- themes ------------------------------------------------------------------

# Where the installed themes live, one JSON file each. Defaults to
# <SIGIL_HOME>/themes. The theme in use and the reasoning visibility are stored in
# <SIGIL_HOME>/ui.json, not here: they are changed from the UI with /theme and
# /reasoning-visibility.
# SIGIL_THEMES_DIR=~/.sigil/themes
