# Límite duro de pasos por turno (mensajes del modelo + llamadas a tools).
SIGIL_MAX_STEPS=256

# Intentos totales por request al modelo ante fallos transitorios del proveedor
# (5xx, 429 de rate limit, conexión cortada o timeout). Incluye el primer
# intento. Los errores permanentes (cuota agotada, request rechazado) no se
# reintentan. Default: 5.
SIGIL_MODEL_MAX_ATTEMPTS=5

# Esfuerzo de razonamiento (variante del modelo): low, medium, high, max.
# Vacío = default del modelo.
SIGIL_REASONING_EFFORT=medium
