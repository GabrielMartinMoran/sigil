# Sigil reads these at startup, in the composition root only.
# Provider accounts (keys, models, reasoning level) are configured from the UI
# with /provider, /model and /effort: no credential belongs in this file.

# Model calls per turn, when the agent's profile declares no `max_steps` of its
# own. Running out does not abort: the tools are taken away and the model gets one
# last call to report what it established and what is left.
SIGIL_MAX_STEPS=256

# Total attempts per model request when the provider fails transiently
# (5xx, 429 rate limit, dropped connection or timeout). The first attempt is
# included. Permanent errors (quota exhausted, request rejected) are not retried.
SIGIL_MODEL_MAX_ATTEMPTS=5

# Where Sigil keeps sessions, roadmaps and provider credentials.
# Defaults to ~/.sigil. Uncomment to isolate an installation or a test sandbox.
# SIGIL_HOME=/path/to/sigil-state

# --- context management ------------------------------------------------------

# View strategy: `windowed` applies the compaction events —the reasoning window, the
# tool detail by age, and whole turns only when the request does not fit—; `compacting`
# adds a summary for old turns; `passthrough` sends the history as it is, for
# diagnostics.
SIGIL_CONTEXT_STRATEGY=windowed

# Turns kept intact before the budget starts discarding them.
SIGIL_CONTEXT_KEEP_RECENT_TURNS=3

# Cap of an old tool result in the `compacting` strategy, in characters. It is not the
# level-of-detail ladder: that one is fixed (2000, 500, 100) for tools without a policy
# of their own, and each own tool declares what it keeps.
SIGIL_CONTEXT_MAX_TOOL_RESULT_CHARS=4000

# Tokens reserved for the model response.
SIGIL_CONTEXT_OUTPUT_RESERVE=8000

# What travels back to the model of its own reasoning.
#
# Finished turns are a record; the turn in progress is where the agent re-reads what it
# already decided. There is no switch that keeps all reasoning or drops all of it: the
# two numbers below are the only policy, and a compaction event records the step where
# the window was reduced. Signed reasoning is only replayed to the provider that
# produced it.
SIGIL_CONTEXT_REASONING_STEPS=10

# Ceiling for that reasoning, as a percentage of the model window. The window is
# capped by the smaller of this share and the room the history has left, so a wide
# step count never starves a turn.
SIGIL_CONTEXT_REASONING_MAX_PERCENT=5

# Rounds an image stays loaded, counting the one it arrived in. A round is
# everything until control goes back to the user, steering included. Older pictures
# are replaced by a short id (img_...) that survives the session file, and the
# `view_image` tool hands the bytes back on demand: the model still sees them as
# images. Loading one again restarts its window.
SIGIL_CONTEXT_IMAGE_ROUNDS=3

# Ceiling for the pixels that stay, as a percentage of the model window. Separate
# from the reasoning share: a picture costs an order of magnitude more per item.
SIGIL_CONTEXT_IMAGE_MAX_PERCENT=10

# --- workspaces --------------------------------------------------------------

# Where `/new --worktree` creates the worktrees. It must stay OUTSIDE the
# repository: if it sat inside a work tree, the file tools of one workspace could
# reach the tree of another. One folder per repository and one per worktree name:
# <dir>/<repo>/<name>. Defaults to <SIGIL_HOME>/worktrees.
# SIGIL_WORKTREES_DIR=~/.sigil/worktrees

# --- themes ------------------------------------------------------------------

# Where the installed themes live, one JSON file each. Defaults to
# <SIGIL_HOME>/themes. The theme in use and the reasoning visibility are stored in
# <SIGIL_HOME>/ui.json, not here: they are changed from the UI with /theme and
# /reasoning-visibility.
# SIGIL_THEMES_DIR=~/.sigil/themes

# --- MCP ---------------------------------------------------------------------

# Seconds a stdio MCP server has to exit on EOF when Sigil quits, before it is
# signalled. Well-behaved servers are gone in milliseconds; the default is short
# on purpose, because a server that ignores the EOF used to make quitting wait
# the SDK's two seconds per server.
# SIGIL_MCP_SHUTDOWN_TIMEOUT=0.2
