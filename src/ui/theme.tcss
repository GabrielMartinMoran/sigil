/* Sigil stylesheet.
 *
 * Every color here is a theme variable. The roles (`$primary`, `$panel`, …) come
 * from the theme's palette; the rest (`$tool-border`, `$reasoning`, `$muted`, …)
 * are declared by each theme file and defaulted in
 * `ThemeMixin.get_theme_variable_defaults`, so a theme that only sets `primary`
 * still parses and still looks intentional.
 */

Screen {
    layout: vertical;
}

#root {
    height: 1fr;
}

#main {
    height: 1fr;
}

/* --- chat ---------------------------------------------------------------- */

#chat {
    width: 1fr;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

.user-msg {
    margin-top: 1;
    color: $text;
}

.assistant-msg {
    margin-top: 1;
}

/* Tool calls carry their own gutter and colors in the renderable: the border is
 * drawn per line so the block reads as one indented column, not as a list. */
.tool-call {
    margin-top: 1;
}

/* Consecutive calls share no gap: a run of them is one column under the answer. */
.tool-call.tight {
    margin-top: 0;
}

/* A spawn that can be opened is a target: the underline is in the renderable and
 * the hover confirms it, so the block does not need a hint line of its own. */
.tool-call.clickable:hover {
    background: $boost;
}

.notice {
    margin-top: 1;
}

/* --- composer ------------------------------------------------------------ */

#prompt {
    height: auto;
    max-height: 10;
    /* The resting border is muted on purpose, and it is the same width and style
     * as the focused one: an unfocused composer still looks like a composer, so
     * the only way to know it is not listening is to say so, and gaining the focus
     * must not move a single cell. `$muted` is Sigil's own variable, defaulted by
     * `ThemeMixin.get_theme_variable_defaults` so the sheet parses before any
     * theme is registered. */
    border: round $muted;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#prompt:focus {
    border: round $accent;
}

/* The composer while a subagent is on screen: read-only, and it says so. Textual
 * already fades a disabled focusable widget, which dims the resting border
 * further; the text opacity is what makes it read as "not for you right now"
 * rather than as a slightly dimmer version of the same thing. */
#prompt:disabled {
    text-opacity: 60%;
}

/* --- menu ---------------------------------------------------------------- */

#menu {
    height: auto;
    max-height: 8;
    border: round $accent;
    background: $panel;
}

/* --- status bar ---------------------------------------------------------- */

#status {
    height: 1;
    background: $panel;
    padding: 0 1;
}

/* --- side panel ---------------------------------------------------------- */

/* One box, one scrollbar. The whole panel scrolls instead of nesting a scrolling
 * roadmap inside a scrolling panel: two scrollbars in 34 characters of width are
 * one more than the width can explain. A plan of thirty items and twenty loaded
 * skills still leave the composer where it belongs. */
#sidebar {
    width: 34;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#sidebar-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#sidebar-body {
    height: auto;
}

/* --- debug view ---------------------------------------------------------- */

#conversation {
    width: 1fr;
    height: 1fr;
}

#debug {
    width: 1fr;
    height: 1fr;
    border: round $warning;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#debug-header {
    height: auto;
    padding: 0 0 1 0;
}

#debug-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#debug-body {
    height: auto;
}

/* --- agent view (a subagent, opened) ------------------------------------- */

#agent {
    width: 1fr;
    height: 1fr;
    border: round $success;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#agent-header {
    height: auto;
    padding: 0 0 1 0;
}

#agent-chat {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#tree-status {
    height: 1;
    color: $text-muted;
}

#tree-list {
    height: 1fr;
}

/* --- modal chrome -------------------------------------------------------- */

SessionPicker,
AgentTreeScreen,
ProviderScreen,
AccountFormScreen,
ModelPickerScreen,
ConfirmScreen,
TextPromptScreen,
EffortScreen,
ThemePickerScreen {
    align: center middle;
}

#picker {
    width: 80%;
    height: 60%;
    border: round $accent;
    background: $panel;
    padding: 1 2;
}

#sessions {
    height: 1fr;
}

/* Not a modal: it borrows height from the chat and lets the conversation stay
 * readable while the question is answered. */
QuestionPanel {
    height: auto;
    max-height: 60%;
    border: round $accent;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#question-progress {
    height: 1;
    color: $text-muted;
}

#question-title {
    height: auto;
}

#question-answers {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#question-options {
    height: auto;
    max-height: 12;
    margin-top: 1;
}

#question-custom {
    margin-top: 1;
}

#question-hint,
#question-help {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

/* The hint is the abort warning (`Esc` cancels the run): it earns the color. */
#question-hint {
    color: $warning;
}

/* --- provider screens ---------------------------------------------------- */

ProviderScreen,
AccountFormScreen,
ModelPickerScreen,
AgentPickerScreen,
ConfirmScreen,
TextPromptScreen {
    align: center middle;
}

#provider-box {
    width: 80%;
    height: auto;
    max-height: 85%;
    border: round $accent;
    background: $panel;
    padding: 1 2;
}

#provider-title {
    text-style: bold;
    margin-bottom: 1;
}

#provider-list,
#form-options,
#picker-models,
#agent-list,
#confirm-options {
    height: auto;
    max-height: 16;
}

#provider-empty,
#confirm-question {
    margin-bottom: 1;
}

#form-alias,
#form-secret,
#picker-filter,
#agent-filter,
#prompt-text {
    margin-top: 1;
}

#form-status,
#picker-status,
#agent-status,
#prompt-status {
    margin-top: 1;
    height: auto;
}

#provider-hint {
    margin-top: 1;
    color: $text-muted;
}

#effort-options {
    height: auto;
    max-height: 12;
}

#effort-status {
    margin-bottom: 1;
    height: auto;
}

/* --- theme picker -------------------------------------------------------- */

/* No scrim at all. The app behind *is* the preview: dimming it would hide the one
 * thing the screen exists to show. The box is opaque, so the layering still reads. */
ThemePickerScreen {
    background: transparent;
}

/* The scrim is drawn by a separate, transparent-overlay rule: `$background 60%`
 * blends toward the terminal's own color, which on a dark theme reads as a black
 * curtain over the app. `transparent` lets the preview through. */
ThemePickerScreen > #theme-wrap {
    background: transparent;
}

#theme-wrap {
    align: center middle;
    height: 1fr;
}

/* Narrow on purpose: the whole point is to watch the app behind it change. */
#theme-box {
    width: 46;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $panel;
    padding: 1 2;
}
