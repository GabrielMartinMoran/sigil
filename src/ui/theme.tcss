Screen {
    layout: vertical;
}

#root {
    height: 1fr;
}

#chat {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#menu {
    height: auto;
    max-height: 8;
    border: round $accent;
    background: $panel;
}

#prompt {
    height: auto;
    border: round $accent;
}

#status {
    height: 1;
    background: $panel;
    padding: 0 1;
}

.user-msg {
    margin-top: 1;
    color: $text;
}

.assistant-msg {
    margin-top: 1;
}

.tool-call {
    color: cyan;
}

.tool-result {
    color: $text-muted;
}

.notice {
    margin-top: 1;
}

SessionPicker {
    align: center middle;
}

#picker {
    width: 80%;
    height: 60%;
    border: round $accent;
    background: $panel;
    padding: 1 2;
}

#sessions {
    height: 1fr;
}

#main {
    height: 1fr;
}

#sidebar {
    width: 34;
    height: 1fr;
}

#sidebar-panel {
    height: auto;
    border: round $primary;
    padding: 0 1;
    margin-bottom: 1;
}

#roadmap {
    width: 1fr;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#chat {
    width: 1fr;
}

#debug {
    width: 1fr;
    height: 1fr;
    border: round $warning;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#debug-header {
    height: auto;
    padding: 0 0 1 0;
}

#debug-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#debug-body {
    height: auto;
}

QuestionScreen {
    align: center middle;
}

#question-box {
    width: 80%;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $panel;
    padding: 1 2;
}

#question-options {
    height: auto;
    max-height: 12;
}

#question-custom {
    margin-top: 1;
}

#question-help {
    margin-top: 1;
    color: $text-muted;
}

/* --- provider screens ---------------------------------------------------- */

ProviderScreen,
AccountFormScreen,
ModelPickerScreen,
ConfirmScreen,
TextPromptScreen {
    align: center middle;
}

#provider-box {
    width: 80%;
    height: auto;
    max-height: 85%;
    border: round $accent;
    background: $panel;
    padding: 1 2;
}

#provider-title {
    text-style: bold;
    margin-bottom: 1;
}

#provider-list,
#form-options,
#picker-models,
#confirm-options {
    height: auto;
    max-height: 16;
}

#provider-empty,
#confirm-question {
    margin-bottom: 1;
}

#form-alias,
#form-secret,
#picker-filter,
#prompt-text {
    margin-top: 1;
}

#form-status,
#picker-status,
#prompt-status {
    margin-top: 1;
    height: auto;
}

#provider-hint {
    margin-top: 1;
    color: $text-muted;
}

#effort-options {
    height: auto;
    max-height: 12;
}

#effort-status {
    margin-bottom: 1;
    height: auto;
}

EffortScreen {
    align: center middle;
}
